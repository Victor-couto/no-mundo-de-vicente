# Configurações de Integração do PagBank (Checkout Transparente + Vercel)
# Este arquivo serve apenas como exemplo de placeholders. Não adicione chaves reais aqui.

# Define o ambiente da API do PagBank (sandbox ou production)
PAGBANK_ENV=sandbox

# Chave token de API privada (Bearer Token) gerada no painel do PagBank
PAGBANK_TOKEN=

# Chave pública para criptografia de cartões no front-end
PAGBANK_PUBLIC_KEY=

# URL pública de produção do seu site (necessária para registrar a rota de webhooks)
# Exemplo: https://no-mundo-de-vicente.vercel.app
APP_BASE_URL=
