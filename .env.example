# Configurações de Integração do Mercado Pago (Checkout Pro + Vercel)
# Este arquivo serve apenas como exemplo de placeholders. Não adicione chaves reais aqui.

# Access Token privado (Bearer Token) gerado no painel de desenvolvedores do Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=

# URL onde a API/webhook está hospedada (Vercel) — usada para registrar a rota de notificação
# Exemplo: https://no-mundo-de-vicente.vercel.app
APP_BASE_URL=

# URL pública do site que o cliente navega (Netlify) — usada nos back_urls do Checkout Pro
# (para onde o Mercado Pago redireciona o cliente após o pagamento)
# Exemplo: https://nomundodevicente.com.br
SITE_BASE_URL=

# Chave de API do Resend, usada para enviar e-mails de notificação de venda e rastreio
RESEND_API_KEY=

# Credenciais do Firebase Admin SDK (usadas pelas funções /api/webhooks e /api/admin)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
